<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>F6Launcher.BackgroundHost</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <ApplicationIcon>../HoYoShadeHub/Assets/f6-logo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/BackgroundProtocol.cs" Link="BackgroundProtocol.cs" />
    <Compile Include="../Shared/MultiplayerProcessNames.cs" Link="MultiplayerProcessNames.cs" />
    <Compile Include="../HoYoShadeHub/Features/GameLauncher/FpsUnlocker.cs" Link="FpsUnlocker.cs" />
    <Compile Include="../HoYoShadeHub/Features/GameLauncher/FpsRemoteLifetime*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../HoYoShadeHub.Extensions/Games/GameProcessDiscovery.cs" Link="GameProcessDiscovery.cs" />
  </ItemGroup>
</Project>

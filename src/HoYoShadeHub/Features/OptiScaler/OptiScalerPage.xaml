<?xml version="1.0" encoding="utf-8" ?>
<sf:PageBase x:Class="HoYoShadeHub.Features.OptiScaler.OptiScalerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:HoYoShadeHub.Features.OptiScaler"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sf="using:HoYoShadeHub.Frameworks"
             x:DefaultBindMode="OneWay"
             mc:Ignorable="d">

    <Grid Padding="18,4,30,12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="OptiScaler" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBlock x:Name="TextBlock_Game"
                       VerticalAlignment="Center"
                       Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <Button Click="Button_Refresh_Click" Content="刷新" />
            <Button Click="Button_OpenLibrary_Click" Content="打开 OptiScaler 目录" />
            <Button Click="Button_OpenPresetFolder_Click" Content="配置目录" />
            <!--  注入用的 DLL 文件名（游戏会按名字认代理 dll）。默认 OptiScaler，最下面「自定义」可选其它名字  -->
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="DLL 名称" />
            <ComboBox x:Name="ComboBox_DllName"
                      MinWidth="140"
                      SelectionChanged="ComboBox_DllName_SelectionChanged" />
            <TextBox x:Name="TextBox_CustomDllName"
                     MinWidth="140"
                     PlaceholderText="xxx.dll"
                     TextChanged="TextBox_CustomDllName_TextChanged"
                     Visibility="Collapsed" />
            <!--  注入时机（OptiScaler，按游戏）：暂时隐藏，固定 0（AppConfig.GetOptiScalerInjectDelayEffective）  -->
            <TextBlock VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="注入时机"
                       Visibility="Collapsed" />
            <NumberBox x:Name="NumberBox_OptiInjectDelay"
                       Width="150"
                       Minimum="0"
                       Maximum="30"
                       SmallChange="1"
                       SpinButtonPlacementMode="Compact"
                       PlaceholderText="跟随全局"
                       Visibility="Collapsed"
                       ValueChanged="NumberBox_OptiInjectDelay_ValueChanged"
                       ToolTipService.ToolTip="OptiScaler 注入前等游戏稳定几秒。0 = 立即；留空 = 跟随全局默认。只影响这一个游戏。" />
            <TextBlock x:Name="TextBlock_Count"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- 每个构建一张卡：标题、空白处或单选圈选择构建；配置控件只修改设置。 -->
        <!--  ItemsControl 没有内置滚动，所以用 ScrollViewer 包住（工具栏/标题固定，只有列表滚）  -->
        <ScrollViewer Grid.Row="2" Padding="0,0,6,0">
            <ItemsControl x:Name="OptiScalerSourceList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel>
                        <!--  入场交给 MotionAnimations.PlayListEntrance，这里只留挪位  -->
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                    </StackPanel>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:OptiScalerBuildItemViewModel">
                    <Border Margin="0,0,0,6"
                            Padding="12,8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Tapped="Card_Tapped"
                            ToolTipService.ToolTip="点击标题、空白处或单选圈选择此构建；下拉框只修改设置">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 单选圈是明确的选择动作，也支持键盘；状态在保存成功后更新。 -->
                        <RadioButton Grid.Column="0"
                                     Grid.Row="0"
                                     MinWidth="0"
                                     Padding="0,0,4,0"
                                     VerticalAlignment="Center"
                                     Click="Button_SelectBuild_Click"
                                     IsChecked="{x:Bind IsInUse, Mode=OneWay}"
                                     IsEnabled="{x:Bind SettingsEnabled, Mode=OneWay}"
                                     AutomationProperties.Name="选择此 OptiScaler 构建" />

                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="6">
                            <!--  第一行：来源 + 版本 + 标签 + 「使用中」  -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           Text="{x:Bind Title, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Padding="6,1"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        CornerRadius="3"
                                        Visibility="{x:Bind InUseVisibility, Mode=OneWay}">
                                    <TextBlock FontSize="11"
                                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                               Text="使用中" />
                                </Border>
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="{x:Bind TagsText}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="这个包里没有 OptiScaler.dll"
                                           Visibility="{x:Bind DllMissingVisibility, Mode=OneWay}" />
                            </StackPanel>
                            <!--  第二行：这一版装在哪 / 注入哪个文件  -->
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Text="{x:Bind Detail, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- 配置区的空白和说明文字也不参与构建选择。 -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Tapped="Settings_Tapped">

                                <TextBlock VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Text="当前配置：" />
                                <ComboBox MinWidth="160"
                                          IsEnabled="{x:Bind SettingsEnabled, Mode=OneWay}"
                                          ItemsSource="{x:Bind PresetOptions, Mode=OneWay}"
                                          SelectedItem="{x:Bind CurrentPreset, Mode=TwoWay}" />
                                <Button Padding="8,2" Click="Button_PresetAdd_Click" IsEnabled="{x:Bind SettingsEnabled, Mode=OneWay}" ToolTipService.ToolTip="新增配置（空配置 / 复制现有 / 从网络下载 / 从文件导入 ini·zip）">
                                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                                </Button>
                                <Button Padding="8,2" Click="Button_PresetOpenFile_Click" IsEnabled="{x:Bind SettingsEnabled, Mode=OneWay}" ToolTipService.ToolTip="修改：用编辑器打开这份配置">
                                    <FontIcon FontSize="14" Glyph="&#xE70F;" />
                                </Button>
                                <Button Padding="10,2" Click="Button_PresetRename_Click" IsEnabled="{x:Bind SettingsEnabled, Mode=OneWay}" Content="重命名" />
                                <TextBlock VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="{x:Bind CurrentProfileText}"
                                           TextTrimming="CharacterEllipsis" />
                                <ComboBox x:Name="ComboBox_NrVersion" Width="160" VerticalAlignment="Center" Loaded="ComboBox_Nr_Loaded" SelectionChanged="ComboBox_Nr_SelectionChanged" IsEnabled="{x:Bind SettingsEnabled, Mode=OneWay}" ToolTipService.ToolTip="选择本游戏 NR 版本；选择后立即保存，重启游戏生效" AutomationProperties.Name="NR 版本" />
                                </StackPanel>
                            </StackPanel>

                            <!--  展开 / 收起「扩展配置」。按钮内容不能挂 x:Bind（XamlCompiler 会崩），
                                  拆成两个静态字形按钮、靠 Visibility 切换（和插件卡片同款）。  -->
                            <Button Grid.Column="2"
                                    Grid.Row="0"
                                    MinWidth="32"
                                    Padding="6,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="Button_ExpandQuick_Click"
                                    IsEnabled="{x:Bind SettingsEnabled, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="展开扩展配置（FG / NR / Hook 等 20 项快捷开关）"
                                    Visibility="{x:Bind ExpandButtonVisibility, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE70D;" />
                            </Button>
                            <Button Grid.Column="2"
                                    Grid.Row="0"
                                    MinWidth="32"
                                    Padding="6,2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="Button_ExpandQuick_Click"
                                    IsEnabled="{x:Bind SettingsEnabled, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="缩回去"
                                    Visibility="{x:Bind CollapseButtonVisibility, Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE70E;" />
                            </Button>

                            <!--  扩展配置：20 项快捷开关，写进当前配置（或 profile）  -->
                            <StackPanel x:Name="OptiQuickConfig" Grid.Row="1" Tapped="Settings_Tapped"
                                        Grid.ColumnSpan="3"
                                        Margin="0,6,0,0"
                                        Spacing="6"
                                        Visibility="{x:Bind ExpandedVisibility, Mode=OneWay}">
                                <MenuFlyoutSeparator />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Text="扩展配置（写进当前生效的 OptiScaler 配置；auto = 跟随默认）"
                                           TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{x:Bind QuickItems, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:OptiQuickItemViewModel">
                                            <Grid ColumnSpacing="8" Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="210" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{x:Bind Label, Mode=OneWay}"
                                                           TextWrapping="Wrap"
                                                           ToolTipService.ToolTip="{x:Bind ToolTip, Mode=OneWay}" />
                                                <!--  三态：auto / 开 / 关  -->
                                                <ComboBox Grid.Column="1"
                                                          MinWidth="170"
                                                          IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                          SelectedIndex="{x:Bind TriIndex, Mode=TwoWay}"
                                                          Visibility="{x:Bind TriVisibility, Mode=OneWay}">
                                                    <ComboBoxItem Content="auto（默认）" />
                                                    <ComboBoxItem Content="开" />
                                                    <ComboBoxItem Content="关" />
                                                </ComboBox>
                                                <!--  选项：从给定取值里选  -->
                                                <ComboBox Grid.Column="1"
                                                          MinWidth="170"
                                                          IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                          DisplayMemberPath="Label"
                                                          ItemsSource="{x:Bind Choices, Mode=OneWay}"
                                                          SelectedIndex="{x:Bind OptionIndex, Mode=TwoWay}"
                                                          Visibility="{x:Bind OptionVisibility, Mode=OneWay}" />
                                                <!--  数字  -->
                                                <NumberBox Grid.Column="1"
                                                           MinWidth="170"
                                                           IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                           Maximum="{x:Bind NumberMaximum}"
                                                           Minimum="{x:Bind NumberMinimum}"
                                                           SpinButtonPlacementMode="Compact"
                                                           PlaceholderText="auto"
                                                           Value="{x:Bind NumberValue, Mode=TwoWay}"
                                                           Visibility="{x:Bind NumberVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="TextBlock_Status"
                   Grid.Row="3"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap" />
    </Grid>

</sf:PageBase>

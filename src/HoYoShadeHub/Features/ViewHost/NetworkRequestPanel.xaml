<UserControl x:Class="HoYoShadeHub.Features.ViewHost.NetworkRequestPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HoYoShadeHub.Features.ViewHost">
    <StackPanel x:Name="PanelContent" Width="330" Spacing="4" Visibility="Collapsed">
        <Border x:Name="RequestDetails" MaxHeight="250" Padding="10"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="RequestList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:NetworkRequestRow">
                            <StackPanel Margin="0,3,0,5" Spacing="1">
                                <TextBlock FontSize="12" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="10" Opacity="0.7" Text="{x:Bind Endpoint}" TextTrimming="CharacterEllipsis" />
                                <ProgressBar Height="3" Margin="0,4,0,0" Maximum="100"
                                             Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                                             IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                             Value="{x:Bind Percent, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Button x:Name="Summary" HorizontalAlignment="Right" FontSize="11" Padding="9,4"
                Click="Summary_Click" Content="后台请求" />
    </StackPanel>
</UserControl>
